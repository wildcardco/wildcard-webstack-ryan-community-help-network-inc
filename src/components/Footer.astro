---
import {
  addressLines,
  donateUrl,
  email,
  facebookUrl,
  footerLinks,
  instagramUrl,
  locationNote,
  phoneDisplay,
  phoneTel,
  photos,
  siteName,
} from '../data/site';
---

<footer class="site-footer">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="inline-block">
        <img src={photos.logo.src} alt={photos.logo.alt} width="96" height="96" class="h-24 w-24 object-contain" />
      </a>
      <p class="mt-3 font-semibold">{siteName}</p>
      <p class="text-sm">Home of Buddy Bags</p>
    </div>

    <address class="not-italic">
      <p class="font-semibold">Visit</p>
      <p class="mt-2">
        {addressLines[0]}<br />
        {addressLines[1]}
      </p>
      <p class="mt-2 text-sm">{locationNote}</p>
      <p class="mt-3">
        <a href={`tel:${phoneTel}`}>{phoneDisplay}</a>
      </p>
      <p>
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </address>

    <nav aria-label="Footer">
      <p class="font-semibold">On this site</p>
      <ul class="mt-2 grid grid-cols-1 gap-1 text-sm">
        {footerLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex flex-col items-start gap-3">
      <a class="btn btn-primary" href={donateUrl} target="_blank" rel="noopener noreferrer">
        Donate
        <span class="sr-only">on Zeffy, opens in a new tab</span>
      </a>
      <a class="btn btn-secondary" href="/how-to-help/">Volunteer</a>
      <p class="mt-2 font-semibold">Social</p>
      <a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a>
      <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-4 text-center text-sm">
    <p>{siteName}. Crown Point, Indiana.</p>
  </div>
</footer>
