---
import Base from '../layouts/Base.astro';
---

<Base
  title="Supporters"
  description="A place for Community Help Network supporters. Names are waiting for the owner to confirm."
>
  <header class="bg-base-200">
    <div class="mx-auto max-w-6xl px-4 py-10">
      <h1 class="text-4xl font-semibold text-primary">Supporters</h1>
      <p class="mt-3 max-w-3xl text-lg">
        A special thank you to all the people and businesses that have helped us help others.
      </p>
    </div>
  </header>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="alert alert-warning" role="note">
      <span>
        Supporter names were not extracted for this preview. The current site shows a wall of supporter logos. No names are listed here until the owner confirms who should appear. Nothing on this page is invented.
      </span>
    </div>
  </div>
</Base>
