---
import Base from '../layouts/Base.astro';

const officers = [
  ['Eden Koenig', 'Executive Director'],
  ['Lindsay Frohnapple', 'Director of Operations'],
  ['Denise Gifford', 'Corresponding Secretary'],
  ['Aracely Ledezma', 'Recording Secretary'],
  ['Gail Smith', 'Treasurer'],
  ['Jessica Nicks', 'Co-Treasurer'],
  ['Ruth Argenta', 'Board President'],
  ['Paul Sills', 'Board Vice President'],
];

const members = [
  'Robert Votaw',
  'Bette J Oesterle',
  'Thomas Midgett',
  'Sandy Noe-Braccolino',
  'Janice Malchow',
];
---

<Base
  title="Board 2026"
  description="Community Help Network Board 2026 names and roles, as listed on the current board page."
>
  <header class="bg-base-200">
    <div class="mx-auto max-w-6xl px-4 py-10">
      <h1 class="text-4xl font-semibold text-primary">Board 2026</h1>
      <p class="mt-3 max-w-3xl text-lg">Meet the team, as listed for 2026.</p>
    </div>
  </header>

  <div class="mx-auto max-w-6xl space-y-10 px-4 py-12">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {officers.map(([name, role]) => (
        <li class="card bg-base-200">
          <div class="card-body">
            <h2 class="card-title text-lg">{name}</h2>
            <p>{role}</p>
          </div>
        </li>
      ))}
    </ul>

    <section>
      <h2 class="section-title text-3xl font-semibold">Board members</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {members.map((name) => (
          <li class="rounded-box bg-base-200 px-4 py-3 font-semibold">{name}</li>
        ))}
      </ul>
    </section>

    <section class="card bg-base-200">
      <div class="card-body">
        <h2 class="card-title">Founder</h2>
        <p>Bonnie J Meyer</p>
      </div>
    </section>
  </div>
</Base>
